# MCP Stealth Chrome — Environment Variables
# Copy to .env and fill in as needed. Never commit the .env file.
# All variables are optional; the app runs offline with no secrets.

# ── Guardrails (keep these at the safe defaults) ──────────────────────────

# Enforce read-only mode — no blockchain writes
READ_ONLY=true

# Allow transaction broadcasting — NEVER set to true in production
ALLOW_TX=false

# ── MCP Server ─────────────────────────────────────────────────────────────

# Enable the Gradio MCP server (alternative to demo.launch(mcp_server=True))
GRADIO_MCP_SERVER=True

# ── Analysis settings ──────────────────────────────────────────────────────

# Path to a baseline JSON (list of finding ids) for suppression
# BASELINE_PATH=./evidence/baseline.json

# Severity gate for CI: fail when active findings at or above this severity
# are found. One of: critical, high, medium, low, info
# FAIL_ON=high

# Directory for writing evidence artifacts (defaults to system temp dir)
# EVIDENCE_DIR=./evidence

# ── Optional live EVM recon (gated — not required for the Space to boot) ──

# thirdweb secret key — only needed for live EVM recon (not used by default)
# THIRDWEB_SECRET_KEY=

# Custom RPC endpoint — only needed for live EVM recon
# EVM_RPC_URL=
