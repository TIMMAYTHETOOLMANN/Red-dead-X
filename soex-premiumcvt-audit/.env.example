# Never commit real keys.
CLUSTER=devnet
RPC_URL=https://api.devnet.solana.com
TARGET_PROGRAM_ID=
IDL_PATH=./targets/premiumcvt.json
KNOWN_ACCOUNTS=./targets/accounts.txt

# Guardrails
READ_ONLY=true
ALLOW_TX=false
MAX_ACCOUNTS=50
EVIDENCE_DIR=./evidence

# Economic invariant simulator (npm run invariant-sim)
# Pin these from source before trusting output. FEE_BPS=500 == 5%.
FEE_BPS=500
FEE_ROUNDING=floor
# SUPPLY_CAP=
# PROBE_AMOUNTS=0,1,2,19,100,1000,u64max
# Deep referral-chain simulation (opt-in): set REFERRAL_DEPTH to enable.
# REFERRAL_DEPTH=8
# REFERRAL_REWARD_BPS=100
# REFERRAL_BASE_AMOUNT=1000
# REFERRAL_MAX_TOTAL=

# Static IDL analyzer (npm run analyze-idl)
# BASELINE_PATH: suppress reviewed findings (JSON array of ids, or one id per line).
# BASELINE_PATH=./targets/baseline.json
# FAIL_ON: exit non-zero when a finding at/above this severity survives the baseline
# (one of: critical, high, medium, low, info). Useful for CI gating.
# FAIL_ON=high

# Guardrailed PoC harness (npm run poc) — the system's "hands".
# Simulates by default. Sending a transaction requires ALL of:
#   EXECUTE=true, ALLOW_TX=true, and CLUSTER in {localnet, devnet}.
# Mainnet sends are always refused. Keypairs must be git-ignored *.keypair.json.
# POC_PLAN=./targets/poc-plan.json
EXECUTE=false

# --- Multi-chain forensics (BugRap ecosystem) ------------------------------
# Program registry (all BugRap programs, chains, bounty types, payout bands).
REGISTRY_PATH=./targets/bugrap-programs.json
# Scope a run to one program (key from the registry, e.g. bitget, merlinchain).
# BUGRAP_PROGRAM=soex-premiumcvt

# thirdweb SDK (https://portal.thirdweb.com). Read-only recon needs ONE of:
# THIRDWEB_SECRET_KEY (server-side) or THIRDWEB_CLIENT_ID. Never commit these.
# THIRDWEB_SECRET_KEY=
# THIRDWEB_CLIENT_ID=

# EVM recon target (npm run evm-recon — read-only ABI/impl/bytecode via thirdweb).
# EVM_CHAIN can be a catalog key ("ethereum") or numeric id ("1").
# EVM_CHAIN=ethereum
# EVM_ADDRESS=0x...

# Offline forensic scan (npm run forensic-scan) — analyze ABIs/IDLs you hold.
# EVM_ABI_PATH=./targets/contract-abi.json
# .NET recon (dotnet/ThirdwebForensics) uses EVM_CHAIN_ID (numeric) + EVM_ADDRESS.
# EVM_CHAIN_ID=1
